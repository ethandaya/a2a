{
  "name": "a2a-local",
  "version": "0.1.0",
  "private": true,
  "description": "A local MCP bridge for one-to-one Signal-encrypted agent conversations.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": { "a2a": "dist/cli.js" },
  "files": ["dist", "src", "tsconfig.json", "README.md", "LICENSE"],
  "packageManager": "pnpm@12.0.0",
  "engines": { "node": ">=24.13.0" },
  "scripts": {
    "a2a": "node src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "pnpm build && node --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@signalapp/libsignal-client": "0.103.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
